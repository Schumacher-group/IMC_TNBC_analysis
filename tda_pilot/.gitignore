# Upstream demo repo (separate project; clone via README, do not vendor)
M2S2_demo/

# Python environment(s)
.venv/
uv.lock

# Regeneratable heavy outputs (raw diagrams ~422 MB, partitioned stats ~22 MB)
output/diagrams/
output/stats/
output/logs/
# Keep the small analysis record under output/: *.md reports, *.png figures,
# and per_roi_summary.parquet (the Day-2 feature table). These are committed.
# The repo-root .gitignore ignores *csv, so un-ignore the small output tables we keep.
!output/roi_geometry.csv

# Per-ROI point clouds (regeneratable from the cell table via adapter.py)
data/*.csv

# Synthetic install-test scratch
_install_test/

# Python caches
__pycache__/
*.pyc
